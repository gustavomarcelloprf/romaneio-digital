# Variáveis de ambiente do Romaneio Digital (backend)
# Copie para .env (ou exporte no shell) e preencha com valores reais.
# NUNCA commite o arquivo .env com valores reais.

# Chave secreta do Flask (sessões/cookies). Obrigatória — o app não sobe sem ela.
# Gere uma com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Token de acesso às rotas /admin/*. Obrigatório — o app não sobe sem ele.
# Enviado no header Authorization das requisições de admin.
ADMIN_TOKEN=troque-por-um-token-admin-secreto

# URL do PostgreSQL (psycopg 3). Obrigatória — o app não sobe sem ela.
# O banco é Postgres-only: não há mais arquivo SQLite. Crie o banco antes
# (ex.: createdb romaneio) — o schema é criado/migrado pelo app no boot.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/romaneio

# Postgres de TESTE usado por pytest (backend/tests). Obrigatória para rodar
# a suíte. O schema desse banco é APAGADO e recriado a cada teste: use um
# banco separado, nunca o de dev/produção.
TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/romaneio_test

# Porta HTTP do servidor (opcional, padrão: 5001)
PORT=5001

# Cookie de sessão só via HTTPS (opcional, padrão: true).
# Defina false só para teste local em http:// — em produção mantenha true.
# Fail-safe: apenas o valor explícito "false" desliga; qualquer outro valor
# (inclusive typo) mantém o cookie seguro.
SESSION_COOKIE_SECURE=true
